{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2020",
    "lib": [
      "ES2020"
    ],
    "types": [
      "google-apps-script"
    ],
    "skipLibCheck": true
  },
  "include": [
    "src/server/*.js",
    "src/shared/*.js",
    "types/i18n.d.ts",
    "types/calendar.d.ts"
  ]
}
