{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2020",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [],
    "skipLibCheck": true
  },
  "include": [
    "src/browser/*.js",
    "types/browser.d.ts",
    "src/shared/*.js",
    "types/i18n.d.ts"
  ]
}
