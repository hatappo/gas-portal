{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2020",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [],
    "skipLibCheck": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "module": "ESNext",
    "moduleResolution": "bundler"
  },
  "include": [
    "src/browser/*.js",
    "types/browser.d.ts",
    "src/shared/*.js",
    "types/i18n.d.ts",
    "src/browser/*.tsx",
    "types/calendar.d.ts"
  ]
}
