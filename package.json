{
  "name": "gas-portal",
  "version": "0.9.0",
  "description": "A personal work portal built with Google Apps Script.",
  "type": "module",
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": "26.x",
    "npm": ">=11.20.0"
  },
  "scripts": {
    "lint": "oxlint && node scripts/gas-syntax.mjs",
    "typecheck": "tsc -p tsconfig.server.json && tsc -p tsconfig.client.json",
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build.mjs && node scripts/package-assets.mjs",
    "check": "npm run lint && npm run typecheck && npm run build && npm test",
    "dev": "vite",
    "preview": "vite",
    "prepack": "npm run build",
    "pack:local": "npm run build && node scripts/pack-local.mjs",
    "build:favicons": "node scripts/build-favicons.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "test:browser": "node --test tests/browser/*.test.mjs",
    "probe:slack": "node scripts/slack-probe.mjs"
  },
  "devDependencies": {
    "@fontsource/libre-baskerville": "5.3.0",
    "@fontsource/shippori-mincho": "5.3.0",
    "@kobalte/core": "0.13.14",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/vite": "4.3.3",
    "@types/google-apps-script": "2.0.14",
    "daisyui": "5.7.50",
    "espree": "11.2.0",
    "jsdom": "30.1.3",
    "opentype.js": "2.0.0",
    "oxlint": "1.89.0",
    "playwright": "1.64.1",
    "solid-js": "1.9.18",
    "tailwindcss": "4.3.3",
    "terser": "5.51.2",
    "typescript": "5.9.3",
    "vite-plugin-solid": "2.11.15"
  },
  "license": "MIT",
  "bin": {
    "portal": "bin/portal.mjs"
  },
  "files": [
    "bin/",
    "lib/",
    "assets/",
    "README.md",
    "LICENSE",
    "NOTICE",
    "docs/usage.md"
  ],
  "keywords": [
    "google-apps-script",
    "clasp",
    "portal",
    "personal-dashboard"
  ],
  "dependencies": {
    "@google/clasp": "3.4.1",
    "vite": "8.3.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hatappo/gas-portal.git"
  },
  "homepage": "https://github.com/hatappo/gas-portal#readme",
  "bugs": {
    "url": "https://github.com/hatappo/gas-portal/issues"
  }
}
