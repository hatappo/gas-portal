{
  "name": "gas-portal",
  "version": "0.1.0",
  "description": "A personal Google Apps Script portal, distributed with a multi-account deployment CLI.",
  "type": "module",
  "packageManager": "npm@12.2.1",
  "engines": {
    "node": "26.x",
    "npm": ">=12.2.1"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.server.json && tsc -p tsconfig.client.json",
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build.mjs && node scripts/package-assets.mjs",
    "check": "npm run lint && npm run typecheck && npm run build && npm test",
    "dev": "vite",
    "preview": "vite",
    "prepack": "npm run build",
    "pack:local": "npm run build && node scripts/pack-local.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/google-apps-script": "2.0.14",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "typescript": "5.9.3"
  },
  "license": "MIT",
  "bin": {
    "portal": "bin/portal.mjs"
  },
  "files": [
    "bin/",
    "lib/",
    "assets/",
    "README.md",
    "LICENSE",
    "NOTICE",
    "docs/usage.md"
  ],
  "keywords": [
    "google-apps-script",
    "clasp",
    "portal",
    "personal-dashboard"
  ],
  "dependencies": {
    "@google/clasp": "3.4.1",
    "vite": "8.3.5"
  }
}
