{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "unicorn",
    "oxc"
  ],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    "dist/**",
    "assets/**",
    "node_modules/**"
  ],
  "env": {
    "builtin": true,
    "es2024": true,
    "node": true
  },
  "globals": {
    "PortalI18n": "readonly",
    "PortalUrlSchemes": "readonly",
    "PortalThemes": "readonly",
    "PortalCatalogRules": "readonly",
    "PortalCacheDurations": "readonly"
  },
  "rules": {
    "no-undef": "error",
    "no-unused-vars": "error"
  },
  "overrides": [
    {
      "files": [
        "tests/browser/*.mjs"
      ],
      "env": {
        "browser": true,
        "node": true
      }
    },
    {
      "files": [
        "src/server/*.js"
      ],
      "globals": {
        "HtmlService": "readonly",
        "UrlFetchApp": "readonly",
        "ScriptApp": "readonly",
        "LockService": "readonly",
        "Sheets": "readonly",
        "CacheService": "readonly",
        "Utilities": "readonly",
        "PropertiesService": "readonly"
      },
      "rules": {
        "no-unused-vars": [
          "error",
          {
            "varsIgnorePattern": "^(getGitHubConnections|saveGitHubConnection|disconnectGitHub|getGitHubActionItems|doGet|getCatalog|saveCatalogCacheTtl|saveActionsCacheTtl|normalizeCatalogCacheTtl_|readCachedSheetCatalog_|saveTheme|saveLanguage|include_|parseCatalog_|readSheetCatalog_|initializeScriptProperties|initializeProperties|savePortalSettings|saveSpreadsheetSettings|createPortalSpreadsheet|saveUnblockedUrlSchemes|doGet|getPortalLanguage_|getPortalPropertyDefaults_|getPortalTheme_|getPortalUserProperties_|initializeProperties|isPortalTheme_|normalizeActionsCacheTtl_|normalizeCatalogCacheTtl_|normalizePortalIcon_|normalizeSpreadsheetId_|parseCatalog_|readCachedSheetCatalog_|withPortalPropertiesLock_)$"
          }
        ]
      }
    },
    {
      "files": [
        "src/browser/*.js",
        "src/browser/*.tsx"
      ],
      "env": {
        "browser": true
      },
      "globals": {
        "google": "readonly"
      }
    },
    {
      "files": [
        "src/server/Code.js"
      ],
      "globals": {
        "getPortalPropertyDefaults_": "readonly",
        "getPortalTheme_": "readonly",
        "getPortalUserProperties_": "readonly",
        "isPortalTheme_": "readonly",
        "normalizeActionsCacheTtl_": "readonly",
        "normalizeCatalogCacheTtl_": "readonly",
        "normalizePortalIcon_": "readonly",
        "normalizeSpreadsheetId_": "readonly",
        "readCachedSheetCatalog_": "readonly"
      }
    },
    {
      "files": [
        "src/server/GitHub.js"
      ],
      "globals": {
        "normalizeActionsCacheTtl_": "readonly"
      }
    },
    {
      "files": [
        "src/server/SheetCatalog.js"
      ],
      "globals": {
        "doGet": "readonly",
        "getPortalUserProperties_": "readonly",
        "normalizeCatalogCacheTtl_": "readonly",
        "normalizeSpreadsheetId_": "readonly",
        "parseCatalog_": "readonly"
      }
    },
    {
      "files": [
        "src/server/SpreadsheetSetup.js"
      ],
      "globals": {
        "getPortalLanguage_": "readonly",
        "initializeProperties": "readonly",
        "withPortalPropertiesLock_": "readonly"
      }
    }
  ]
}
